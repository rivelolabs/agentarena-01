# ---- required ----
# Any Postgres works. Examples:
#   local      postgres://postgres:postgres@localhost:5432/agentswar
#   Supabase   the "Session pooler" string from Project → Connect (TLS is switched on automatically)
#   Railway    ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agentswar
# Generate all secrets with:  npm run keys:new -w @clashagent/server
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ENCRYPTION_KEY=64-hex-chars-from-keys-new
CORS_ORIGINS=http://localhost:3000
SIWS_DOMAIN=localhost:3000
# PORT=4000                           # change if something else on your machine already uses 4000

# ---- Google sign-in (optional) ----
# OAuth "Web application" client ID from Google Cloud Console. No client secret is needed.
# Leave empty to offer wallet sign-in only. See DEPLOY.md, step 2.
GOOGLE_CLIENT_ID=

# ---- solana ----
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_PUBLIC_RPC_URL=            # RPC handed to browsers (use a Helius/Triton URL in production)
TREASURY_ADDRESS=                    # enables deposits / credits
TREASURY_SECRET_KEY=                 # optional: enables automatic withdrawals and the On-chain stake mode (hot wallet, keep it small)
SOLANA_PROGRAM_ID=                   # clash_escrow program id (enables on-chain escrow)
ORACLE_SECRET_KEY=                   # key allowed to settle escrow matches

# ---- economics & safety ----
FEE_BPS=500
MIN_STAKE_LAMPORTS=0
MAX_STAKE_LAMPORTS=5000000000
DEVNET_WELCOME_LAMPORTS=1000000000
REAL_MONEY_ENABLED=false             # must be true for stakes/withdrawals on mainnet-beta

# ---- battle tuning ----
LLM_TIMEOUT_MS=20000
TURN_MIN_MS=2600
WORLD_TICK_MS=21600000               # length of one Realm day (6 h = four Realm days per real day; use 60000 to test fast)
REALM_BRAIN_EVERY_DAYS=3             # opted-in agents plan their own day with their model every N days
REALM_BRAIN_MAX_PER_TICK=8           # cap on those model calls per world day
MAX_CONCURRENT_BATTLES=25
# Free play credits (no real value): sign-up gift, daily claim, max stake per play match
WELCOME_PLAY_CREDITS=1000
DAILY_PLAY_CREDITS=200
MAX_PLAY_STAKE=100000
FREE_MATCHES_PER_WEEK=2                # free matches (play credits, or anything on devnet) per player per 7 days; 0 = unlimited
