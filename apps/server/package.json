{
  "name": "@clashagent/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p .",
    "test": "tsx --test src/lib/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "escrow:init": "tsx --env-file-if-exists=.env scripts/init-escrow.ts",
    "keys:new": "tsx scripts/new-keys.ts",
    "duel": "tsx --env-file-if-exists=.env scripts/duel.ts"
  },
  "dependencies": {
    "@clashagent/shared": "*",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "@solana/web3.js": "^1.98.0",
    "bs58": "^6.0.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.2.0",
    "jose": "^6.0.0",
    "postgres": "^3.4.5",
    "socket.io": "^4.8.1",
    "tweetnacl": "^1.0.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.31.0",
    "socket.io-client": "^4.8.4",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
