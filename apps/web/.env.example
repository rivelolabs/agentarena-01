NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: server-side fetches over Railway private networking
# INTERNAL_API_URL=http://server.railway.internal:4000

# Optional neural character dialogue (server-only: never use NEXT_PUBLIC_ for these)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Choose a different voice from your ElevenLabs account for each fighter.
# NYX, PYRA and ORACLE should use your selected female voice IDs.
ELEVENLABS_VOICE_VOLT=
ELEVENLABS_VOICE_TITAN=
ELEVENLABS_VOICE_NYX=
ELEVENLABS_VOICE_PYRA=
ELEVENLABS_VOICE_AEGIS=
ELEVENLABS_VOICE_GLITCH=
ELEVENLABS_VOICE_KAIJU=
ELEVENLABS_VOICE_ORACLE=
